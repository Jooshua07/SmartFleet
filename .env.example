# Copy only to .env.flask.local, never to the legacy Streamlit .env.
# scripts/setup_flask_dev.py generates isolated local credentials and an owner login.
SMARTFLEET_ENV=development
SMARTFLEET_SECRET_KEY=replace-with-at-least-32-random-characters
SMARTFLEET_OWNER_USERNAME=owner
SMARTFLEET_OWNER_PASSWORD_HASH=replace-with-a-werkzeug-password-hash
SMARTFLEET_DB_HOST=127.0.0.1
SMARTFLEET_DB_PORT=5432
SMARTFLEET_DB_NAME=smartfleet_flask_dev
SMARTFLEET_DB_USER=smartfleet_flask_dev_reader
SMARTFLEET_DB_PASSWORD=replace-with-isolated-development-password
SMARTFLEET_TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
# Optional: scripts/setup_flask_stage2.py generates the isolated restricted writer.
# Never use the schema-owner or production credentials here.
# SMARTFLEET_WRITE_DB_USER=smartfleet_flask_dev_writer
# SMARTFLEET_WRITE_DB_PASSWORD=replace-with-isolated-writer-password
